# ── Application ──
APP_NAME=competitive-analysis-backend
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# ── Data directory (optional) ──
# Isolates JSON store / SQLite for dev or perf runs
# APP_DATA_DIR=./data

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./data/competitive_analysis.db

# ── LLM Configuration ──
# Provider: mock | openai | anthropic
LLM_PROVIDER=openai

# OpenAI — set when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com

# ── Search (recommended) ──
TAVILY_API_KEY=tvly-your-key-here

# ── Demo mode ──
# false = require real API keys; unset = auto-detect from keys
DEMO_MODE=false

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Workflow ──
WORKFLOW_MAX_DURATION_SECONDS=300
WORKFLOW_MAX_RETRIES=3
WORKFLOW_HITL_ENABLED=false

# Intent LLM timeout (seconds) — interactive path; keep short under single-worker Deep load
# INTENT_LLM_TIMEOUT_S=20

# ── Frontend (CORS / deploy) ──
# FRONTEND_URL=http://localhost:3000
